[Unit]
Description=PredatorSense Linux: apply the saved lighting/fan/overclock profile
Documentation=file:///usr/local/share/doc/predator-sense/RECOVERY.md
After=systemd-modules-load.service
Wants=systemd-modules-load.service
ConditionPathExists=/usr/local/bin/predator-sense

[Service]
Type=oneshot
Environment=HOME=__HOME__
# Wait for the keyboard HID and WMI device nodes to appear at boot.
ExecStartPre=-/usr/bin/udevadm settle --timeout=10
ExecStart=/usr/local/bin/predator-sense --allow-oc profile apply default
RemainAfterExit=yes
Nice=10

[Install]
WantedBy=multi-user.target
