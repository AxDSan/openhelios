[Unit]
Description=PredatorSense Linux: apply the Acer Predator lighting/fan profile
Documentation=file:///usr/local/share/doc/predator-sense/RECOVERY.md
After=systemd-modules-load.service
Wants=systemd-modules-load.service
ConditionPathExists=/usr/local/bin/predator-sense

[Service]
Type=oneshot
ExecStart=/usr/local/bin/predator-sense profile apply default
RemainAfterExit=yes
# The WMI mailbox needs root; the HID udev rule is used for interactive runs.
Nice=10

[Install]
WantedBy=multi-user.target
